{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DB Client",
  "version": "0.1.0",
  "identifier": "com.dbclient.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DB Client",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "MadnessCODE",
    "copyright": "© 2026 MadnessCODE",
    "shortDescription": "Fast desktop client for PostgreSQL and MySQL",
    "longDescription": "DB Client by MadnessCODE: connect, query and explore PostgreSQL and MySQL databases."
  }
}
